{
  "name": "lan-drop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "pm2 start ecosystem.config.cjs",
    "test": "node --test tests/server.test.js",
    "test:e2e": "playwright test",
    "package:win": "node scripts/build-portable.mjs",
    "test:portable": "node scripts/test-portable.mjs",
    "start:direct": "node server/index.js",
    "restart": "pm2 restart ecosystem.config.cjs --update-env",
    "stop": "pm2 stop lan-drop",
    "logs": "pm2 logs lan-drop",
